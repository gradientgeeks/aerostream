# Multi-stage Dockerfile for AeroStream Go Controller
# Stage 1: Build
FROM golang:1.22-alpine AS builder

RUN apk add --no-cache ca-certificates git tzdata

WORKDIR /app

# Cache dependencies
COPY go-controller/go.mod go-controller/go.sum ./go-controller/
RUN cd go-controller && go mod download

# Copy source code and protos
COPY proto ./proto
COPY go-controller ./go-controller

# Compile statically linked Go binary
RUN cd go-controller && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /bin/controller cmd/controller/main.go

# Stage 2: Minimal Runtime
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata curl bash && \
    mkdir -p /data /etc/aeromq

WORKDIR /app

COPY --from=builder /bin/controller /usr/local/bin/controller

# 7001: Raft consensus
# 8001: gRPC cluster control & discovery
# 9001: HTTP/REST management & health checks (/status, /join)
EXPOSE 7001 8001 9001

VOLUME ["/data"]

ENTRYPOINT ["controller"]
CMD ["-id", "node1", "-raft-addr", "0.0.0.0:7001", "-grpc-addr", "0.0.0.0:8001", "-http-addr", "0.0.0.0:9001", "-data-dir", "/data", "-bootstrap"]
