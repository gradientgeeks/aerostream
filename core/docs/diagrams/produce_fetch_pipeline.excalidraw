      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 2. read() syscall copies bytes from Page Cache into User-Space JVM/Go buffer (Context Switch 1 & 2)",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "\u2022 2. read() syscall copies bytes from Page Cache into User-Space JVM/Go buffer (Context Switch 1 & 2)",
