      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "In-Place Base Offset Patching & Zero Re-allocation",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "In-Place Base Offset Patching & Zero Re-allocation",
      "lineHeight": 1.25
    },
    {
      "id": "0aa4a635",
      "type": "text",
      "x": 120,
      "y": 904,
      "width": 848,
      "height": 20,
      "angle": 0,
      "strokeColor": "#cbd5e1",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2056,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 Traditional brokers deserialize record batches, update offsets, and re-serialize into a new buffer.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "\u2022 Traditional brokers deserialize record batches, update offsets, and re-serialize into a new buffer.",
      "lineHeight": 1.25
    },
    {
      "id": "f4359fbe",
      "type": "text",
      "x": 120,
      "y": 926,
      "width": 907,
      "height": 20,
      "angle": 0,
      "strokeColor": "#cbd5e1",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2057,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 AeroStream performs direct binary patching: offsets are written directly into known byte offsets in-place.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "\u2022 AeroStream performs direct binary patching: offsets are written directly into known byte offsets in-place.",
      "lineHeight": 1.25
    },
    {
      "id": "d837254f",
      "type": "text",
      "x": 120,
      "y": 948,
      "width": 814,
      "height": 20,
      "angle": 0,
      "strokeColor": "#cbd5e1",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2058,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 Guarantees exactly ONE copy of message bytes from network socket directly to kernel page cache.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "\u2022 Guarantees exactly ONE copy of message bytes from network socket directly to kernel page cache.",
      "lineHeight": 1.25
    },
