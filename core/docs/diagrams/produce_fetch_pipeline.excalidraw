      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Paced sync_file_range Dirty Page Writeback",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "Paced sync_file_range Dirty Page Writeback",
      "lineHeight": 1.25
    },
    {
      "id": "731c1e01",
      "type": "text",
      "x": 1600,
      "y": 904,
      "width": 823,
      "height": 20,
      "angle": 0,
      "strokeColor": "#cbd5e1",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2061,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 Calls sync_file_range(fd, pos, len, SYNC_FILE_RANGE_WRITE) to asynchronously initiate writeback.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "\u2022 Calls sync_file_range(fd, pos, len, SYNC_FILE_RANGE_WRITE) to asynchronously initiate writeback.",
      "lineHeight": 1.25
    },
    {
      "id": "c6db838e",
      "type": "text",
      "x": 1600,
      "y": 926,
      "width": 806,
      "height": 20,
      "angle": 0,
      "strokeColor": "#cbd5e1",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2062,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 Prevents Linux kernel pdflush dirty-page background writeback spikes from blocking user space.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "\u2022 Prevents Linux kernel pdflush dirty-page background writeback spikes from blocking user space.",
      "lineHeight": 1.25
    },
    {
      "id": "771f45a7",
      "type": "text",
      "x": 1600,
      "y": 948,
      "width": 705,
      "height": 20,
      "angle": 0,
      "strokeColor": "#cbd5e1",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2063,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 Smooths SSD/NVMe wear leveling and ensures deterministic real-time tail latencies.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "\u2022 Smooths SSD/NVMe wear leveling and ensures deterministic real-time tail latencies.",
      "lineHeight": 1.25
    },
