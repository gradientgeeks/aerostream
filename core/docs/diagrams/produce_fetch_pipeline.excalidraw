      "link": null,
      "locked": false,
      "text": "\u2022 2. Linux kernel performs Direct Memory Access (DMA): Page Cache -> NIC Network Buffer directly",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
