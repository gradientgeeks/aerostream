      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "\u2022    \u2022 Validates broker_id, host, data_port (9091), kafka_port (9092), rack ID",
      "lineHeight": 1.25
    },
    {
