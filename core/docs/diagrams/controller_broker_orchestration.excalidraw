      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "\u2022    \u2022 Proposes CmdRegisterBroker to Raft log; responds with cluster ID and assigned partitions",
      "lineHeight": 1.25
    },
