# Settings for the EC2 benchmark. Sourced by every script; override any value via the environment.

# --- AWS ---------------------------------------------------------------------------------------------------------
export AWS_PROFILE="${AWS_PROFILE:-aerostream-bench}"     # least-privilege service account (see iam/)
export AWS_REGION="${AWS_REGION:-us-east-1}"
export AWS_DEFAULT_REGION="$AWS_REGION"
export AZ="${AZ:-us-east-1a}"                              # both nodes in ONE availability zone (same subnet)
export PROJECT_TAG="aerostream-bench"                      # the IAM policy only lets this account touch tagged resources
export TOPOLOGY="${TOPOLOGY:-two}"                          # two: broker node + client node | single: ONE machine, cores split in half
export SINGLE_TYPE="${SINGLE_TYPE:-c6id.2xlarge}"           # single mode: 8 vCPU / 4 cores, 16 GiB, local NVMe
export BROKER_TYPE="${BROKER_TYPE:-c6id.xlarge}"           # 4 vCPU, 8 GiB, 237 GB local NVMe (Xeon 8375C)
export CLIENT_TYPE="${CLIENT_TYPE:-c6i.xlarge}"            # 4 vCPU, 8 GiB (load generator on its own machine)
export ROOT_GB="${ROOT_GB:-50}"
# AL2023 AMI via the public SSM parameter (the only AMI parameter the service account may read)
export AMI_PARAM="/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
export SSH_USER="ec2-user"

# --- what runs ---------------------------------------------------------------------------------------------------
export SYSTEMS="${SYSTEMS:-aerostream}"                  # systems to run, in order (rotated every round, see 05-run-benchmarks.sh)
export PROFILE="${PROFILE:-fair}"                          # quick | fair | full (see README.md)
export MODE="${MODE:-parity}"                              # parity: broker container limited to 2 CPU / 2 GiB like omb-run.sh
                                                           # fullnode: broker container gets 4 CPU / 7 GiB
export COOLDOWN_SEC="${COOLDOWN_SEC:-45}"                  # idle time between runs
export KAFKA_IMAGE="${KAFKA_IMAGE:-apache/kafka:3.7.0}"
export REDPANDA_IMAGE="${REDPANDA_IMAGE:-redpandadata/redpanda:latest}"   # digest is recorded in run-info.json
export OMB_REPO="https://github.com/openmessaging/openmessaging-benchmark.git"
export OMB_COMMIT="${OMB_COMMIT:-5b1fa70951a323da26bd587174b58bb2c65b0b5c}"   # same commit as the local benchmarks/ checkout

# --- safety ------------------------------------------------------------------------------------------------------
# Both instances are launched with instance-initiated-shutdown=terminate and a `shutdown -h +N` timer, so they delete
# themselves after N minutes even if this machine dies. 05-run-benchmarks.sh sets N from the profile if unset.
export MAX_RUNTIME_MIN="${MAX_RUNTIME_MIN:-}"
export KEEP="${KEEP:-0}"                                   # KEEP=1: do not destroy at the end (debugging; you pay for it!)

# --- profile -> workloads, rounds, durations ---------------------------------------------------------------------
case "$PROFILE" in
  quick) WORKLOADS="1kb-16p-maxrate 1kb-16p-50k";                                   ROUNDS=1; WARM=1; TEST=3 ;;
  fair)  WORKLOADS="1kb-16p-maxrate 1kb-16p-50k";                                   ROUNDS=2; WARM=2; TEST=5 ;;
  native8) WORKLOADS="1kb-32p-maxrate-8x8 1kb-32p-100k-8x8 1kb-32p-200k-8x8";       ROUNDS=2; WARM=2; TEST=5 ;;   # single 8-vCPU machine, AeroStream NATIVE protocol
  aero8) WORKLOADS="1kb-32p-maxrate-8x8 1kb-32p-100k-8x8 1kb-32p-200k-8x8";        ROUNDS=2; WARM=2; TEST=5 ;;   # single 8-vCPU machine, AeroStream only
  full)  WORKLOADS="1kb-16p-maxrate 1kb-16p-50k 1kb-16p-100k 100b-16p-maxrate";     ROUNDS=3; WARM=2; TEST=10 ;;
  *) echo "unknown PROFILE=$PROFILE" >&2; exit 2 ;;
esac
export WORKLOADS ROUNDS WARM TEST
